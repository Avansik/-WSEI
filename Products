<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Freeze | Products</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: Arial, Helvetica, sans-serif;
    background:#f5f5f5;
    overflow-x:hidden;
}

/* HEADER */

.header{

    background:
    linear-gradient(135deg,#ff2db8,#ffee00);

    padding:50px 20px;

    text-align:center;

    color:white;
}

.header h1{
    font-size:60px;
    letter-spacing:4px;
}

.header p{
    margin-top:15px;
    font-size:20px;
}

/* NAVIGATION */

.menu{

    display:flex;
    justify-content:center;
    gap:40px;

    padding:20px;

    background:white;

    position:sticky;
    top:0;

    z-index:1000;

    box-shadow:0 5px 15px rgba(0,0,0,0.08);
}

.menu a{

    text-decoration:none;

    color:#555;

    font-size:18px;
    font-weight:bold;

    position:relative;

    transition:0.3s;
}

.menu a::after{

    content:'';

    position:absolute;
    left:0;
    bottom:-5px;

    width:0%;
    height:2px;

    background:#ff2db8;

    transition:0.3s;
}

.menu a:hover{
    color:#ff2db8;
}

.menu a:hover::after{
    width:100%;
}

/* PRODUCTS SECTION */

.products{

    width:90%;
    max-width:1400px;

    margin:80px auto;

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

    gap:40px;
}

/* PRODUCT CARD */

.card{

    background:white;

    border-radius:30px;

    overflow:hidden;

    box-shadow:0 10px 30px rgba(0,0,0,0.08);

    transition:0.4s;
}

.card:hover{

    transform:
    translateY(-10px)
    scale(1.02);

    box-shadow:0 20px 40px rgba(0,0,0,0.15);
}

.card img{

    width:100%;
    height:280px;

    object-fit:cover;
}

/* CARD CONTENT */

.card-content{

    padding:30px;
}

.card-content h2{

    color:#ff2db8;

    margin-bottom:15px;

    font-size:28px;
}

.card-content p{

    color:#666;

    line-height:1.7;

    margin-bottom:20px;
}

.price{

    font-size:30px;
    font-weight:bold;

    color:#222;

    margin-bottom:20px;
}

/* BUTTON */

.btn{

    display:inline-block;

    padding:14px 28px;

    border-radius:50px;

    text-decoration:none;

    background:
    linear-gradient(135deg,#ff2db8,#ff69d4);

    color:white;

    font-weight:bold;

    transition:0.3s;
}

.btn:hover{

    transform:translateY(-4px);

    box-shadow:0 10px 20px rgba(255,45,184,0.4);
}

/* FOOTER */

.footer{

    margin-top:80px;

    background:#ff2db8;

    padding:40px 20px;

    text-align:center;

    color:white;
}

.social-icons{

    margin-bottom:20px;

    display:flex;
    justify-content:center;
    gap:20px;
}

.social-icons a{

    width:50px;
    height:50px;

    border-radius:50%;

    background:white;

    display:flex;
    justify-content:center;
    align-items:center;

    transition:0.3s;
}

.social-icons a:hover{

    background:#ffee00;

    transform:translateY(-5px);
}

.social-icons img{
    width:24px;
}

/* RESPONSIVE */

@media(max-width:700px){

    .header h1{
        font-size:40px;
    }

    .menu{
        flex-wrap:wrap;
        gap:20px;
    }
}

</style>
</head>

<body>

<!-- HEADER -->

<header class="header">

    <h1>OUR PRODUCTS</h1>

    <p>Healthy frozen yogurt with amazing flavors</p>

</header>

<!-- MENU -->

<nav class="menu">

    <a href="index.html">Home</a>
    <a href="about.html">About</a>
    <a href="products.html">Products</a>
    <a href="contact.html">Contact</a>

</nav>

<!-- PRODUCTS -->

<section class="products">

    <!-- PRODUCT 1 -->

    <div class="card">

        <img src="./product1.jpg" alt="Strawberry Yogurt">

        <div class="card-content">

            <h2>Strawberry Freeze</h2>

            <p>
                Fresh strawberry frozen yogurt made from natural berries
                and premium milk ingredients.
            </p>

            <div class="price">$5.99</div>

            <a href="#" class="btn">
                Order Now
            </a>

        </div>

    </div>

    <!-- PRODUCT 2 -->

    <div class="card">

        <img src="./product2.jpg" alt="Chocolate Yogurt">

        <div class="card-content">

            <h2>Chocolate Dream</h2>

            <p>
                Rich chocolate frozen yogurt with smooth creamy texture
                and sweet cocoa topping.
            </p>

            <div class="price">$6.49</div>

            <a href="#" class="btn">
                Order Now
            </a>

        </div>

    </div>

    <!-- PRODUCT 3 -->

    <div class="card">

        <img src="./product3.jpg" alt="Vanilla Yogurt">

        <div class="card-content">

            <h2>Vanilla Sky</h2>

            <p>
                Light vanilla yogurt with natural vanilla aroma
                and refreshing taste.
            </p>

            <div class="price">$5.49</div>

            <a href="#" class="btn">
                Order Now
            </a>

        </div>

    </div>

    <!-- PRODUCT 4 -->

    <div class="card">

        <img src="./product4.jpg" alt="Blueberry Yogurt">

        <div class="card-content">

            <h2>Blueberry Ice</h2>

            <p>
                Delicious blueberry frozen yogurt with antioxidant-rich
                berries and creamy texture.
            </p>

            <div class="price">$6.99</div>

            <a href="#" class="btn">
                Order Now
            </a>

        </div>

    </div>

</section>

<!-- FOOTER -->

<footer class="footer">

    <div class="social-icons">

        <a href="https://facebook.com">
            <img src="./fb.png" alt="">
        </a>

        <a href="https://instagram.com">
            <img src="./insta.png" alt="">
        </a>

        <a href="https://twitter.com">
            <img src="./twiter.png" alt="">
        </a>

        <a href="https://youtube.com">
            <img src="./youtube.png" alt="">
        </a>

    </div>

    <p>© 2026 Freeze. All Rights Reserved.</p>

</footer>

</body>
</html>
